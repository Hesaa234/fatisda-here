rules_version = '2';

// Aturan keamanan Firestore untuk Fatisda Here.
// Cara pasang: Firebase Console > Firestore Database > tab Rules > tempel seluruh isi file ini > Publish.
// Peran dibaca dari users/{uid}.role: "mahasiswa", "dosen", atau "admin".
//
// Catatan: validasi posisi (KNN) tetap dilakukan di aplikasi. Rules memastikan setiap orang
// hanya mengubah data miliknya sendiri, dan absen mahasiswa hanya diterima saat sesi terbuka
// menurut JAM SERVER (mengubah jam HP tidak berpengaruh) dan hanya untuk peserta matkul.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Fungsi bantu ----------
    function signedIn() {
      return request.auth != null;
    }
    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }
    function hasRole(role) {
      return signedIn() && exists(userPath()) && get(userPath()).data.role == role;
    }
    function isAdmin() { return hasRole('admin'); }
    function isDosen() { return hasRole('dosen'); }
    function isMahasiswa() { return hasRole('mahasiswa'); }

    // Dosen pengampu sebuah mata kuliah
    function isLecturerOf(courseId) {
      return isDosen()
        && get(/databases/$(database)/documents/courses/$(courseId)).data.lecturerId == request.auth.uid;
    }

    // Sesi masih terbuka menurut JAM SERVER: belum ditutup dan sekarang ada di antara startAt dan endAt
    function sessionOpen(sessionId) {
      let s = get(/databases/$(database)/documents/sessions/$(sessionId)).data;
      return (!('closedAt' in s) || s.closedAt == null)
        && request.time >= s.startAt
        && request.time <= s.endAt;
    }

    // Mahasiswa terdaftar sebagai peserta mata kuliah
    function isStudentOf(courseId) {
      return request.auth.uid in get(/databases/$(database)/documents/courses/$(courseId)).data.studentIds;
    }

    // ---------- users ----------
    // Semua yang login boleh membaca (nama dosen/peserta). Hanya admin yang menulis.
    match /users/{uid} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ---------- rooms & config ----------
    match /rooms/{roomId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /config/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ---------- courses ----------
    match /courses/{courseId} {
      allow read: if signedIn();
      allow create: if isAdmin()
        || (isDosen() && request.resource.data.lecturerId == request.auth.uid);
      allow update: if isAdmin()
        || (isDosen()
            && resource.data.lecturerId == request.auth.uid
            && request.resource.data.lecturerId == request.auth.uid);
      // Dihapus admin, atau dosen pengampunya sendiri
      allow delete: if isAdmin()
        || (isDosen() && resource.data.lecturerId == request.auth.uid);
    }

    // ---------- sessions ----------
    match /sessions/{sessionId} {
      allow read: if signedIn();
      allow create: if isAdmin()
        || (isLecturerOf(request.resource.data.courseId)
            && request.resource.data.lecturerId == request.auth.uid);
      allow update, delete: if isAdmin()
        || (isDosen() && resource.data.lecturerId == request.auth.uid);
    }

    // ---------- attendances (id = sessionId_uid) ----------
    match /attendances/{attendanceId} {
      // Mahasiswa hanya membaca miliknya (termasuk cek "sudah absen" pada dokumen yang belum ada)
      allow read: if isAdmin() || isDosen()
        || (isMahasiswa() && (resource == null || resource.data.studentId == request.auth.uid));

      // Mahasiswa absen untuk dirinya sendiri: id dokumen harus sessionId_uid, terdaftar di
      // matkulnya, dan sesi masih terbuka menurut jam server
      allow create: if (isMahasiswa()
          && request.resource.data.studentId == request.auth.uid
          && attendanceId == request.resource.data.sessionId + '_' + request.auth.uid
          && isStudentOf(request.resource.data.courseId)
          && sessionOpen(request.resource.data.sessionId))
        || isAdmin()
        || isLecturerOf(request.resource.data.courseId);

      // Perubahan status manual oleh dosen pengampu (Rekap Kehadiran) atau admin
      allow update: if isAdmin() || isLecturerOf(resource.data.courseId);
      allow delete: if isAdmin() || isLecturerOf(resource.data.courseId);
    }

    // ---------- proofs (foto bukti Izin/Sakit, id = sessionId_uid) ----------
    // Foto disimpan sebagai teks Base64 di dokumen ini (bukan Firebase Storage).
    match /proofs/{proofId} {
      // Mahasiswa mengunggah bukti miliknya sendiri; ukuran dibatasi supaya dokumen tidak melebihi 1 MiB
      allow create: if isMahasiswa()
        && request.resource.data.studentId == request.auth.uid
        && proofId == request.resource.data.sessionId + '_' + request.auth.uid
        && isStudentOf(request.resource.data.courseId)
        && sessionOpen(request.resource.data.sessionId)
        && request.resource.data.imageBase64 is string
        && request.resource.data.imageBase64.size() <= 900000;

      // Yang boleh melihat: pemilik, dosen pengampu matkul, admin
      allow read: if isAdmin()
        || (signedIn() && resource.data.studentId == request.auth.uid)
        || isLecturerOf(resource.data.courseId);

      // Dihapus saat dosen mengubah status jadi Alpa
      allow delete: if isAdmin() || isLecturerOf(resource.data.courseId);
      allow update: if false;
    }

    // ---------- knnTests (uji KNN di lapangan dari menu admin) ----------
    match /knnTests/{testId} {
      allow read, create, delete: if isAdmin();
      allow update: if false;
    }

    // ---------- attempts ----------
    match /attempts/{attemptId} {
      allow create: if signedIn() && request.resource.data.studentId == request.auth.uid;
      allow read: if isAdmin() || isDosen();
      allow update, delete: if isAdmin();
    }
  }
}
